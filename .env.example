# ============================================
# GreenSense - Configuración de Base de Datos
# ============================================
# COPIAR este archivo como .env y personalizar los valores
# NO compartir el .env real (ya está en .gitignore)

# SQL Server Connection
# Formato Prisma: sqlserver://host:puerto;database=db;user=user;password=pass
#
# Si usas instancia nombrada (SQLEXPRESS):
#   sqlserver://TU_PC\\SQLEXPRESS:1433;...
#
# Si usas puerto dinámico (common en SQL Server Express):
#   sqlserver://TU_PC:1433;... (sin instancia, solo puerto)
#
# El usuario y password son los de TU SQL Server local

DATABASE_URL="sqlserver://TU_PC\\SQLEXPRESS:1433;database=GreenSenseDB;user=TU_USUARIO;password=TU_PASSWORD;trustServerCertificate=true"

# JWT Secret (cambiar en producción)
JWT_SECRET=REEMPLAZAR_CON_32_O_MAS_CARACTERES_ALEATORIOS

# Credenciales del super admin para crear/ver empresas
# Cambiar en produccion. No exponer con prefijo NEXT_PUBLIC.
SUPER_ADMIN_EMAIL=admin@example.invalid
SUPER_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_FRASE_LARGA_Y_UNICA

# URL publica de la aplicacion para construir enlaces de recuperacion
# Reemplaza TU_IP_LAN por la IP del servidor dentro de tu red local
APP_URL=http://TU_IP_LAN:3000
NEXT_PUBLIC_APP_URL=http://TU_IP_LAN:3000

# Clave que deben enviar ESP32/Arduino/gateways en el header x-iot-key
IOT_API_KEY=REEMPLAZAR_CON_24_O_MAS_CARACTERES_ALEATORIOS

# SMTP para envio real de correos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=REEMPLAZAR_CON_SECRETO_SMTP
SMTP_FROM=GreenSense <no-reply@example.invalid>
